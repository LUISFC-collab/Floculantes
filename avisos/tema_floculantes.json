{
  "name": "Floculantes sobrio",
  "dataColors": ["#122C91", "#2A6FDB", "#48D6D2", "#81E9E6", "#FEFCBF", "#7A8BB8", "#B8C4E6", "#D6F5F4"],
  "background": "#FFFFFF",
  "foreground": "#122C91",
  "tableAccent": "#2A6FDB",
  "good": "#48D6D2",
  "neutral": "#2A6FDB",
  "bad": "#122C91",
  "maximum": "#122C91",
  "center": "#2A6FDB",
  "minimum": "#81E9E6",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#122C91" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#122C91" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#2B3A67" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#122C91" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D6E0F5" } }, "radius": 8 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#122C91" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "visualHeader": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F7FC" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F7FC" } }, "transparency": 0 }]
      }
    },
    "gauge": {
      "*": {
        "dataPoint": [{ "fill": { "solid": { "color": "#2A6FDB" } }, "target": { "solid": { "color": "#122C91" } } }],
        "calloutValue": [{ "color": { "solid": { "color": "#122C91" } }, "fontSize": 24 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#122C91" } }, "fontSize": 26 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#2B3A67" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#122C91" } }, "fontSize": 11 }],
        "items": [{ "fontColor": { "solid": { "color": "#2B3A67" } }, "background": { "solid": { "color": "#FFFFFF" } }, "fontSize": 10 }],
        "selection": [{ "selectAllCheckboxEnabled": true, "singleSelect": false }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3, "showMarker": true, "lineStyle": "solid" }],
        "legend": [{ "show": true, "position": "Top", "fontSize": 10 }],
        "categoryAxis": [{ "gridlineShow": false }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#E6ECF7" } } }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "legend": [{ "show": true, "position": "Top", "fontSize": 10 }],
        "categoryAxis": [{ "gridlineShow": false }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#E6ECF7" } } }]
      }
    }
  }
}
